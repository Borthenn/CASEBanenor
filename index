document.querySelectorAll('.nlpick').forEach(b => b.addEventListener('click', () => { co2Sel = b.dataset.nl; drawRoutes(); co2Panel(); }));

const co2Overview = () => `<h2>Where new lines make most sense</h2><p style="margin:0">Each proposed line is routed automatically across the build map, choosing the path with the fewest conflicts with protected areas, valuable nature, species, salmon rivers and known ground problems. Fjord crossings are allowed at the cost of a subsea tunnel or bridge.</p><p style="margin:0">The carbon panel compares what building the line emits with what it saves each year by moving travellers and freight from cars, planes and trucks to electric trains.</p><p style="margin:0;color:var(--muted)">The routing has no terrain or elevation data, so it cannot see mountains, gradients or where a tunnel would avoid surface conflicts. Treat the lines as corridors to investigate, not alignments.</p>`;

function nguSummary(cls) {
  const out = [];
  for (const [ln, rs] of Object.entries(NGU.runs)) {
    const r = rs.filter(x => !cls || x.c === cls); if (!r.length) continue;
    const order = LINES[ln].map(x => x[0]);
    const byc = {};
    r.forEach(x => { (byc[x.c] = byc[x.c] || []).push(x); });
    for (const [c, xs] of Object.entries(byc)) {
      const idx = xs.flatMap(x => [order.indexOf(x.from), order.indexOf(x.to)]).filter(i => i >= 0);
      out.push({ ln, c, km: xs.reduce((a, x) => a + x.km, 0), a: order[Math.min(...idx)], b: order[Math.max(...idx)] });
    }
  }
  return out.sort((x, y) => y.km - x.km);
}
const NGUNAME = { marine: 'Marine clay deposits', slide: 'Old slide deposits', flood: 'Flood deposits' };
document.getElementById('nguFind').innerHTML = nguSummary().map(f => `<button class="segbtn" data-ngu="${f.c}" style="grid-template-columns:10px minmax(0,1fr)"><i style="background:var(${NGUCOL[f.c]})"></i><span>${f.ln} <em>${f.a}–${f.b}: ${NGUNAME[f.c].toLowerCase()} along ${f.km.toFixed(1)} km</em></span></button>`).join('');
document.querySelectorAll('#nguFind .segbtn').forEach(b => b.addEventListener('click', () => selectNgu(b.dataset.ngu)));
document.getElementById('nguCov').textContent = `NGU’s detailed map covers only about ${NGU.coveredKm} km of the ${NGU.totalKm.toLocaleString('en')} km of corridor, mostly in Gudbrandsdalen, Gauldalen and Saltdal. No findings elsewhere means not mapped in detail, not safe.`;
function selectNgu(c) {
  const f = nguSummary(c), t = NGUTXT[c];
  detail.innerHTML = `<div class="typebar" style="background:var(${NGUCOL[c]})"></div><h3>${NGUNAME[c]}</h3><div class="no">${t.no} · measured data from NGU</div>
    <dl><div><dt>What it shows</dt><dd>${t.what}</dd></div>
    <div><dt>Found along the track</dt><dd>${f.length ? f.map(x => `<b>${x.ln}</b>, ${x.a}–${x.b}: about ${x.km.toFixed(1)} km of corridor`).join('<br>') : 'None within the mapped corridor.'}</dd></div>
    <div><dt>How AI can use it</dt><dd class="ai">Cross the deposit map with track geometry, NADAG boreholes and rainfall forecasts to rank which kilometres need inspection first, and to flag new projects that cut into these deposits.</dd></div>
    <div><dt>Limits</dt><dd class="hum">Track lines on this map are approximate and the corridor is 3 km wide, so this is screening. Engineers confirm the real exposure on site.</dd></div></dl>`;
}
document.getElementById('nguToggle').addEventListener('click', e => {
  const b = e.currentTarget, on = b.getAttribute('aria-pressed') !== 'true';
  b.setAttribute('aria-pressed', String(on)); b.classList.toggle('on', on); nguG.style.display = on ? '' : 'none';
});

select(null);
requestAnimationFrame(updateScale);
</script>

