<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Norway Rail Hazard Map</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,500..800&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: topographic sheet — large map on the left, a field-notes panel on the right that stacks under the map on phones */
:root {
  --sea: #d6e2e6;
  --land: #fbfbf7;
  --neighbor: #e9ece7;
  --lake: #c9dae0;
  --border: #b9a9b6;
  --coast: #6c7d83;
  --ink: #17232a;
  --muted: #56666c;
  --rule: #d5dcdd;
  --panel: #ffffff;
  --page: #eef2f2;
  --rail: #1d2326;
  --rail-gap: #ffffff;
  --focus: #1f6fd1;
  --z-clay: #b07d1c;
  --z-rock: #b3261e;
  --z-snow: #5a4fc9;
  --z-flood: #1f6fd1;
  --z-debris: #dc5f12;
  --z-surge: #0b8a85;
  --z-heat: #c92f74;
  --r-high: #c0271d;
  --r-elev: #d98a0b;
  --r-low: #2f8f5b;
  --f-display: "Archivo", "Arial Narrow", "Helvetica Neue", Arial, sans-serif;
  --f-body: "IBM Plex Sans", "Helvetica Neue", Arial, sans-serif;
  --f-mono: "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  --zone-op: .30;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --sea: #0d171c; --land: #1f2b30; --neighbor: #172126; --lake: #0f1c22; --border: #6e5f6b; --coast: #7d9097;
    --ink: #e6ecee; --muted: #9db0b6; --rule: #2c3a40; --panel: #162026; --page: #10191e;
    --rail: #eef2f3; --rail-gap: #1f2b30; --focus: #6aa8ff;
    --z-clay: #d8a640; --z-rock: #ef5a50; --z-snow: #9a90ff; --z-flood: #5aa2ff; --z-debris: #ff8a3d; --z-surge: #2ec4bd; --z-heat: #f06aa8;
    --r-high: #ff5c50; --r-elev: #f2a93b; --r-low: #4cc285;
    --zone-op: .36; color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --sea: #0d171c; --land: #1f2b30; --neighbor: #172126; --lake: #0f1c22; --border: #6e5f6b; --coast: #7d9097;
  --ink: #e6ecee; --muted: #9db0b6; --rule: #2c3a40; --panel: #162026; --page: #10191e;
  --rail: #eef2f3; --rail-gap: #1f2b30; --focus: #6aa8ff;
  --z-clay: #d8a640; --z-rock: #ef5a50; --z-snow: #9a90ff; --z-flood: #5aa2ff; --z-debris: #ff8a3d; --z-surge: #2ec4bd; --z-heat: #f06aa8;
    --r-high: #ff5c50; --r-elev: #f2a93b; --r-low: #4cc285;
  --zone-op: .36; color-scheme: dark;
}
* { box-sizing: border-box; }
body {
  background: var(--page); color: var(--ink); font: 15px/1.55 var(--f-body);
  padding-left: max(16px, env(safe-area-inset-left, 0px));
  padding-right: max(16px, env(safe-area-inset-right, 0px));
  padding-block: 20px 32px;
}
.wrap { max-width: 1240px; margin: 0 auto; display: grid; gap: 18px; }
header { display: grid; gap: 6px; }
.eyebrow { font: 500 11.5px/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
h1 { font: 800 clamp(26px, 4.4vw, 42px)/1.02 var(--f-display); font-stretch: 82%; letter-spacing: -.01em; margin: 0; text-wrap: balance; }
.lede { margin: 0; max-width: 66ch; color: var(--muted); }
.grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 18px; align-items: start; }
@media (max-width: 900px) { .grid { grid-template-columns: minmax(0, 1fr); } }

.mapcard { background: var(--sea); border: 1px solid var(--rule); border-radius: 6px; position: relative; overflow: hidden; min-width: 0; }
.maptools { position: absolute; top: 10px; left: 10px; right: 10px; display: flex; flex-wrap: wrap; gap: 6px; z-index: 2; pointer-events: none; }
.maptools button { pointer-events: auto; }
.seg { font: 500 12px/1 var(--f-body); border: 1px solid var(--rule); background: var(--panel); color: var(--ink); padding: 7px 10px; border-radius: 4px; cursor: pointer; }
.seg[aria-pressed="true"] { background: var(--ink); color: var(--panel); border-color: var(--ink); }
.seg:focus-visible, .chip:focus-visible, .ev:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
svg.map { display: block; width: 100%; height: auto; max-height: 86vh; touch-action: none; cursor: grab; }
.scale { position: absolute; left: 12px; bottom: 12px; font: 500 11px/1 var(--f-mono); color: var(--ink); display: grid; gap: 4px; background: color-mix(in srgb, var(--panel) 80%, transparent); padding: 6px 8px; border-radius: 3px; }
.scale i { display: block; height: 6px; border: 1.5px solid var(--ink); border-top: 0; }
.north { position: absolute; right: 14px; bottom: 12px; font: 700 12px/1 var(--f-display); color: var(--ink); text-align: center; }
.north svg { display: block; margin: 0 auto 2px; }
.tip { position: absolute; pointer-events: none; background: var(--ink); color: var(--panel); font: 500 12px/1.3 var(--f-body); padding: 5px 8px; border-radius: 3px; white-space: nowrap; transform: translate(-50%, calc(-100% - 10px)); z-index: 3; }

.panel { background: var(--panel); border: 1px solid var(--rule); border-radius: 6px; display: grid; min-width: 0; }
.panel section { padding: 16px 18px; display: grid; gap: 10px; }
.panel section + section { border-top: 1px solid var(--rule); }
.panel h2 { font: 700 13px/1.2 var(--f-display); font-stretch: 90%; letter-spacing: .06em; text-transform: uppercase; margin: 0; color: var(--muted); }
.chips { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.chip { display: flex; align-items: center; gap: 8px; text-align: left; font: 500 13px/1.2 var(--f-body); background: transparent; color: var(--ink); border: 1px solid var(--rule); border-radius: 4px; padding: 7px 8px; cursor: pointer; min-width: 0; }
.chip .sw { flex: none; width: 14px; height: 14px; border-radius: 2px; }
.chip span.l { min-width: 0; }
.chip small { display: block; color: var(--muted); font: 400 11px/1.2 var(--f-body); font-style: italic; }
.chip[aria-pressed="false"] { opacity: .45; }
.chip[aria-pressed="false"] .sw { background: transparent !important; outline: 1.5px dashed var(--muted); }
.chip.on { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
.railkey { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }

.detail { min-height: 240px; }
.detail h3 { font: 750 22px/1.1 var(--f-display); font-stretch: 85%; margin: 0; text-wrap: balance; }
.detail .no { font: italic 400 13px/1.2 var(--f-body); color: var(--muted); }
.detail dl { margin: 0; display: grid; gap: 10px; }
.detail dt { font: 500 10.5px/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 3px; }
.detail dd { margin: 0; font-size: 14px; }
.detail dd.ai { border-left: 3px solid var(--focus); padding-left: 10px; }
.detail dd.hum { border-left: 3px solid var(--ink); padding-left: 10px; }
.tagrow { display: flex; flex-wrap: wrap; gap: 5px; }
.tag { font: 500 11.5px/1 var(--f-body); border: 1px solid var(--rule); border-radius: 3px; padding: 4px 6px; }
.typebar { height: 4px; width: 48px; border-radius: 2px; }

.evs { display: grid; gap: 4px; }
.ev { display: grid; grid-template-columns: 26px minmax(0, 1fr); gap: 10px; align-items: start; background: transparent; border: 0; border-radius: 4px; padding: 7px 6px; text-align: left; color: var(--ink); cursor: pointer; font: inherit; }
.ev:hover, .ev.on { background: color-mix(in srgb, var(--ink) 7%, transparent); }
.ev b { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; background: var(--ink); color: var(--panel); font: 600 11px/1 var(--f-mono); }
.ev span { font-size: 13.5px; line-height: 1.35; }
.ev em { display: block; font: 400 11.5px/1.3 var(--f-mono); font-style: normal; color: var(--muted); margin-top: 2px; }

footer { font-size: 12.5px; color: var(--muted); display: grid; gap: 6px; max-width: 90ch; }
footer a { color: inherit; }
.hit { cursor: pointer; }
.modes { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--rule); border-radius: 5px; overflow: hidden; }
.modes button { font: 600 13px/1.2 var(--f-body); padding: 10px 8px; border: 0; background: transparent; color: var(--ink); cursor: pointer; }
.modes button { border-bottom: 1px solid var(--rule); }
.modes button:nth-child(2n) { border-left: 1px solid var(--rule); }
.modes button:nth-last-child(-n+2) { border-bottom: 0; }
.modes button.wide { grid-column: 1 / -1; border-left: 0; border-top: 1px solid var(--rule); }
.nlpicks { display: grid; grid-template-columns: 1fr; gap: 6px; }
.nlpick { font: 600 13px/1.25 var(--f-body); text-align: left; border: 1px solid var(--rule); background: transparent; color: var(--ink); border-radius: 4px; padding: 8px 10px; cursor: pointer; }
.nlpick[aria-pressed="true"] { border-color: #1f4fd1; box-shadow: inset 0 0 0 1px #1f4fd1; }
.nlpick:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
.nlbar { display: flex; height: 10px; border-radius: 5px; overflow: hidden; background: var(--rule); }
.nlbar i { display: block; height: 100%; }
.nlkm { display: grid; gap: 2px; font-size: 13.5px; } .nlkm span:last-child { color: var(--muted); font-size: 12.5px; }
#nlStats, #nlCalc { display: grid; gap: 10px; }
#nlOfficial { font-size: 13px; line-height: 1.45; border-left: 3px solid #1f4fd1; padding-left: 10px; }
.calc { display: grid; grid-template-columns: minmax(0, 1fr) 118px; gap: 8px; align-items: center; font-size: 13px; }
.calc input { font: 500 13px/1 var(--f-mono); padding: 6px 8px; border: 1px solid var(--rule); border-radius: 4px; background: var(--page); color: var(--ink); width: 100%; font-variant-numeric: tabular-nums; }
.calcnote { font-size: 12px; color: var(--muted); line-height: 1.4; }
.co2grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.co2grid > div { border: 1px solid var(--rule); border-radius: 4px; padding: 8px 10px; display: grid; gap: 2px; min-width: 0; }
.co2grid small { font: 500 10.5px/1 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; color: var(--muted); }
.co2grid b { font: 750 20px/1.1 var(--f-display); font-stretch: 85%; font-variant-numeric: tabular-nums; }
.co2grid span { font-size: 11.5px; color: var(--muted); }
.bchks { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 10px; font-size: 13px; }
.bchk { display: flex; gap: 6px; align-items: center; cursor: pointer; }
.bchk input { accent-color: var(--ink); }
#bgood, #bbad { display: grid; gap: 8px; max-height: 340px; overflow-y: auto; padding-right: 4px; }
.hzpicks { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
.hzpick { font: 600 12.5px/1.2 var(--f-body); border: 1px solid var(--rule); background: transparent; color: var(--ink); border-radius: 4px; padding: 8px; cursor: pointer; text-align: left; display: flex; gap: 8px; align-items: center; }
.hzpick i { width: 12px; height: 12px; border-radius: 2px; flex: none; }
.hzpick[aria-pressed="true"] { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); }
.hzpick:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
#hzList { display: grid; gap: 8px; max-height: 560px; overflow-y: auto; padding-right: 4px; }
.modes button[aria-pressed="true"] { background: var(--ink); color: var(--panel); }
.modes button:focus-visible { outline: 2px solid var(--focus); outline-offset: -3px; }
.modes small { display: block; font: 400 11px/1.2 var(--f-body); opacity: .75; margin-top: 2px; }
.rkey { display: grid; gap: 8px; }
.rrow { display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 10px; align-items: start; font-size: 13.5px; }
.rrow i { height: 8px; border-radius: 4px; margin-top: 6px; }
.rrow b { display: block; font-weight: 600; }
.rrow span { color: var(--muted); font-size: 12.5px; }
.badge { display: inline-block; font: 600 11px/1 var(--f-mono); letter-spacing: .06em; text-transform: uppercase; padding: 5px 7px; border-radius: 3px; color: #fff; }
.routes { display: grid; gap: 10px; }
.route { display: grid; gap: 2px; font-size: 13.5px; border-left: 3px solid var(--rule); padding-left: 10px; }
.route b { font-weight: 600; }
.route span { color: var(--muted); font-size: 12.5px; line-height: 1.4; }
.route.weak { border-left-color: var(--r-high); }
.route.mid { border-left-color: var(--r-elev); }
.seglist { display: grid; gap: 2px; }
.segbtn { display: grid; grid-template-columns: 10px minmax(0, 1fr); gap: 9px; align-items: center; text-align: left; background: transparent; border: 0; border-radius: 4px; padding: 5px 6px; cursor: pointer; color: var(--ink); font: 13px/1.3 var(--f-body); }
.segbtn:hover, .segbtn.on { background: color-mix(in srgb, var(--ink) 7%, transparent); }
.segbtn:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
.segbtn i { width: 10px; height: 10px; border-radius: 50%; }
.segbtn em { font-style: normal; color: var(--muted); }
svg.future .railhit, svg.future .hz { pointer-events: none; }
.mapsvg-label { font-family: var(--f-body); fill: var(--ink); paint-order: stroke; stroke: var(--land); stroke-linejoin: round; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>

<div class="wrap">
  <header>
    <div class="eyebrow">Bane NOR case · Natural hazards (naturfare) and the rail network</div>
    <h1>Where nature threatens Norway's railway</h1>
    <p class="lede">Switch between today's natural hazards, an estimate of which stretches carry the most risk by around 2075, and a link-by-link rating for debris flows, quick clay and heat buckling, and a build map that combines all the nature, protection and hazard data to show where new track can go. Select a hazard, an event or a stretch of line to see why, how AI can help, and which decisions must stay with people.</p>
  </header>

  <div class="grid">
    <div class="mapcard" id="mapcard">
      <div class="maptools" role="group" aria-label="Map view">
        <button class="seg" data-view="all" aria-pressed="true">All of Norway</button>
        <button class="seg" data-view="south" aria-pressed="false">South</button>
        <button class="seg" data-view="mid" aria-pressed="false">Trøndelag–Nordland</button>
        <button class="seg" data-view="north" aria-pressed="false">North</button>
        <button class="seg" id="zin" aria-label="Zoom in" style="min-width:32px">+</button>
        <button class="seg" id="zout" aria-label="Zoom out" style="min-width:32px">−</button>
      </div>
      <svg class="map" id="map" role="img" aria-label="Map of mainland Norway with natural hazard zones, railway lines and event locations"></svg>
      <div class="scale" id="scale"><span id="scaleTxt">100 km</span><i id="scaleBar"></i></div>
      <div class="north" aria-hidden="true"><svg width="14" height="18" viewBox="0 0 14 18"><path d="M7 0 L13 17 L7 13 L1 17 Z" fill="currentColor"/></svg>N</div>
      <div class="tip" id="tip" hidden></div>
    </div>

    <aside class="panel">
      <section>
        <div class="modes" role="group" aria-label="Map mode">
          <button id="mode-today" aria-pressed="true">Hazards today<small>Where each hazard occurs</small></button>
          <button id="mode-future" aria-pressed="false">Rail risk 2075<small>Which stretches are safest</small></button>
          <button id="mode-hz" aria-pressed="false">By hazard<small>Debris, clay and heat per link</small></button>
          <button id="mode-build" aria-pressed="false">Build map<small>All data combined</small></button>
          <button id="mode-co2" aria-pressed="false" class="wide">New lines and CO₂<small>Least-conflict routes and carbon payback</small></button>
        </div>
      </section>
      <section id="secCo2" hidden>
        <h2>Proposed new lines</h2>
        <div class="nlpicks">
          <button class="nlpick" data-nl="nnb" aria-pressed="true">Nord-Norgebanen · Fauske–Narvik–Tromsø</button>
          <button class="nlpick" data-nl="bs" aria-pressed="false">Bergen–Haugesund–Stavanger</button>
          <button class="nlpick" data-nl="rb" aria-pressed="false">Ringeriksbanen · Sandvika–Hønefoss</button>
        </div>
        <div id="nlStats"></div>
      </section>
      <section id="secCo2b" hidden>
        <h2>Carbon: what it costs and saves</h2>
        <div id="nlOfficial"></div>
        <div id="nlCalc"></div>
      </section>
      <section id="secBuild" hidden>
        <h2>Where new track can go</h2>
        <div class="rkey" id="bkey"></div>
        <div style="font-size:12.5px;color:var(--muted)">Datasets included (untick to test what drives the result)</div>
        <div class="bchks" id="bgroups"></div>
      </section>
      <section id="secBuild2" hidden>
        <h2>Existing stretches in conflict</h2>
        <div id="bbad"></div>
        <h2 style="margin-top:6px">Stretches with no mapped conflicts</h2>
        <div id="bgood"></div>
      </section>
      <section id="secHz" hidden>
        <h2>Choose a hazard</h2>
        <div class="hzpicks">
          <button class="hzpick" data-hz="all" aria-pressed="true"><i style="background:var(--r-low)"></i>Where to build</button>
          <button class="hzpick" data-hz="debris" aria-pressed="false"><i style="background:var(--z-debris)"></i>Debris flows</button>
          <button class="hzpick" data-hz="clay" aria-pressed="false"><i style="background:var(--z-clay)"></i>Quick clay</button>
          <button class="hzpick" data-hz="heat" aria-pressed="false"><i style="background:var(--z-heat)"></i>Heat buckling</button>
        </div>
        <div class="rkey"><div class="rrow"><i style="background:var(--r-high)"></i><div><b>High</b><span>Avoid for new track, or plan heavy mitigation</span></div></div><div class="rrow"><i style="background:var(--r-elev)"></i><div><b>Moderate</b><span>Buildable with investigations and design margins</span></div></div><div class="rrow"><i style="background:var(--r-low)"></i><div><b>Low</b><span>Preferred corridor for this hazard</span></div></div></div>
        <div id="hzList"></div>
      </section>
      <section id="secRisk" hidden>
        <h2>Future risk per stretch</h2>
        <div class="rkey" id="rkey"></div>
      </section>
      <section id="secLayers">
        <h2>Map key</h2>
        <div class="chips" id="chips" hidden></div>
        <div class="railkey"><span class="sw" style="display:inline-block;width:14px;height:14px;border-radius:2px;background:linear-gradient(90deg,var(--z-clay) 33%,var(--z-debris) 33% 66%,var(--z-flood) 66%)"></span>NGU-mapped slide, flood and marine clay deposits (data)</div>
        <div class="railkey"><svg width="38" height="8" aria-hidden="true"><line x1="0" y1="4" x2="38" y2="4" stroke="var(--rail)" stroke-width="4"/><line x1="0" y1="4" x2="38" y2="4" stroke="var(--rail-gap)" stroke-width="2" stroke-dasharray="5 5"/></svg>Railway line (hover for name)</div>
      </section>
      <section class="detail" id="detail" aria-live="polite"></section>
      <section id="secNgu">
        <h2>Measured: NGU surficial deposits</h2>
        <p style="margin:0;font-size:13.5px">Real polygons from NGU’s detailed surficial deposit map (Løsmasser detaljert), checked against a 3 km corridor around each line. They show where earlier slides, floods and marine clay have left deposits next to the track.</p>
        <button class="chip on" id="nguToggle" aria-pressed="true" style="justify-self:start"><span class="sw" style="background:linear-gradient(90deg,var(--z-clay) 33%,var(--z-debris) 33% 66%,var(--z-flood) 66%)"></span><span class="l">Show NGU deposits<small>Click a polygon or a finding for detail</small></span></button>
        <div class="routes" id="nguFind"></div>
        <p style="margin:0;font-size:12.5px;color:var(--muted)" id="nguCov"></p>
      </section>
      <section>
        <h2>Open data AI can draw on</h2>
        <div class="routes">
          <div class="route"><b><a href="https://geo.ngu.no/kart/ustabilefjellparti_mobil/" target="_blank" rel="noopener">NGU: Unstable rock slopes</a></b><span>Every mapped unstable mountainside with hazard and risk class. Crossed with the track, it shows which stretches lie in a runout or flood-wave zone.</span></div>
          <div class="route"><b><a href="https://temakart.nve.no/link/?link=jordflomskredaktsomhet" target="_blank" rel="noopener">NVE: Debris flow susceptibility</a></b><span>Possible start and runout areas for debris flows, modelled from 5 m terrain data. Meant for screening, not probability, so it flags where to look closer.</span></div>
          <div class="route"><b><a href="https://geo.ngu.no/kart/nadag_mobil/" target="_blank" rel="noopener">NGU: NADAG ground investigations</a></b><span>National database of boreholes and soil tests. The raw material for finding quick clay along existing and planned lines.</span></div>
          <div class="route"><b><a href="https://geo.ngu.no/kart/radon_mobil/" target="_blank" rel="noopener">NGU: Radon awareness</a></b><span>Not a slide hazard, but relevant for tunnels, stations and workers. High-radon areas such as the alum shale around Oslo affect tunnel work and worker health.</span></div>
        </div>
      </section>
      <section id="secEvents">
        <h2>Recent events on the map</h2>
        <div class="evs" id="evs"></div>
      </section>
