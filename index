const P = GEO.proj;
const R = 6371, rad = Math.PI / 180;
function proj(lon, lat) {
  const rho = R * P.F / Math.pow(Math.tan(Math.PI / 4 + lat * rad / 2), P.n);
  const th = P.n * (lon - P.lon0) * rad;
  const x = rho * Math.sin(th), y = P.rho0 - rho * Math.cos(th);
  return [(x - P.minx) * P.S + P.pad, (P.maxy - y) * P.S + P.pad];
}
const line = pts => pts.map((p, i) => (i ? 'L' : 'M') + proj(p[0], p[1]).map(v => v.toFixed(1)).join(',')).join('');
const poly = pts => line(pts) + 'Z';

